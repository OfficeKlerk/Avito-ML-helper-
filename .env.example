# Пример настроек. Скопируй в .env: cp .env.example .env
# Секретов здесь нет: значения годятся только для локального прототипа.

# Подпись тестовых токенов (JWT HS256). Одинакова у core-api, knowledge-service и corp-mock.
JWT_SECRET=local-dev-secret-change-me-32-bytes-min

# PostgreSQL: одна база, схемы core (core-api) и corp (corp-mock)
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy

# Порты на твоей машине
WEB_PORT=3000
CORE_API_PORT=8080
AGENT_PORT=8090
CORP_MOCK_PORT=8070
KNOWLEDGE_PORT=8060
POSTGRES_PORT=15432
# Заглушки (профиль stubs)
STUB_CORE_API_PORT=18080
STUB_AGENT_PORT=18090
STUB_CORP_MOCK_PORT=18070
STUB_KNOWLEDGE_PORT=18060

# Куда агент ходит за поиском и инструментами. По умолчанию — настоящие сервисы.
# Knowledge-service готов: оставь его адрес по умолчанию.
# Для проверки контрактов можно направить сервисы на заглушку (нужен make stubs-up):
# AGENT_MCP_URL=http://stub-corp-mock:8070/mcp
# CORE_CORP_MOCK_URL=http://stub-corp-mock:8070
# CORE_AGENT_URL=http://stub-agent:8090

# Опциональный отдельный токен управления сбоями corp-mock для тестов.
# CORP_FAULT_TOKEN=

# LLM. mock — режим без модели и без ключа (значение по умолчанию).
# openai — любой OpenAI-совместимый API Chat Completions с вызовом инструментов (tools).
# Наш выбор — YandexGPT в Yandex AI Studio. Как получить ключ — в README, раздел «Подключение LLM».
# Для неё:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   LLM_MODEL=gpt://<ID каталога>/yandexgpt/latest
#   LLM_API_KEY=<секрет API-ключа>
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Общее время на ответ модели и предел вызовов инструментов за одно сообщение.
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOOL_CALLS=5
