map "${PUBLIC_RATE_LIMIT}:$request_method:$uri" $login_limit_key {
    default "";
    "on:POST:/api/auth/login" "login";
}
map "${PUBLIC_RATE_LIMIT}:$request_method:$uri" $chat_limit_key {
    default "";
    "on:POST:/api/chat/messages" "chat";
}
limit_req_zone $login_limit_key zone=public_login:1m rate=20r/m;
limit_req_zone $chat_limit_key zone=public_chat:1m rate=6r/m;
map $upstream_http_x_request_id $diagnostic_id {
    "" $request_id;
    default $upstream_http_x_request_id;
}
log_format buddy '$request_method $status $request_time $diagnostic_id';

server {
    access_log /var/log/nginx/access.log buddy;
    listen 80;
    root /usr/share/nginx/html;
    absolute_redirect off;

    location = /api {
        return 308 /api/;
    }

    location @rate_limited {
        default_type application/json;
        add_header Retry-After 10 always;
        add_header X-Request-Id $diagnostic_id always;
        return 429 '{"error":{"code":"rate_limited","message":"Слишком много запросов. Попробуй чуть позже."}}';
    }

    location /api/ {
        limit_req zone=public_login burst=10 nodelay;
        limit_req zone=public_chat burst=3 nodelay;
        limit_req_status 429;
        limit_req_log_level info;
        error_page 429 = @rate_limited;
        # CORE_API_URL содержит только схему, хост и порт. URI уходит как есть.
        proxy_pass ${CORE_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 90s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
